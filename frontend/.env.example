# Copy to .env.local and adjust if the backend is not on the default port.
#
# The browser talks to FastAPI directly — the API sets CORS allow_origins=["*"],
# so no Next.js rewrite or proxy is involved. This value is inlined into the
# client bundle at build time, so it must be reachable from the browser, not
# just from the Next.js server.
NEXT_PUBLIC_SENTINEL_API=http://127.0.0.1:8000
