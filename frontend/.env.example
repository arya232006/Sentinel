# Copy to .env.local and adjust if the backend is not on the default port.
#
# The browser talks to FastAPI directly — no Next.js rewrite or proxy is
# involved — so the API's SENTINEL_CORS_ORIGINS must name this app's origin.
# Both values are inlined into the client bundle at build time, so they must be
# reachable from the browser rather than just from the Next.js server, and
# changing either needs a rebuild, not a restart.
NEXT_PUBLIC_SENTINEL_API=http://127.0.0.1:8000

# Must equal the backend's SENTINEL_API_TOKEN. Leave empty against a local API,
# which runs with its gate off.
#
# This is compiled into the bundle and readable by anyone who opens devtools. It
# keeps a deployed API from being open to whoever finds the hostname; it is not
# a user credential and does not identify who started a run.
NEXT_PUBLIC_SENTINEL_TOKEN=
