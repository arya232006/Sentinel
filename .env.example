# Copy to .env and fill in.  (Copy, don't rename — this template is committed
# and is the only record of which variables exist.)
ANTHROPIC_API_KEY=

# Budget profile: dev (warn $1 / cap $2) or demo (warn $5 / cap $8).
# Defaults to dev so iteration cannot burn demo-sized budgets by accident.
SENTINEL_PROFILE=dev

# Set to 1 to run the whole pipeline against a deterministic fake LLM.
# No API key needed. Used by the offline test suite.
SENTINEL_FAKE_LLM=0

# ---------------------------------------------------------------------------
# DEV-ONLY shakedown backend. Leave unset for anything real.
#
# SENTINEL_LLM_PROVIDER=openai runs the pipeline against OpenAI instead of
# Claude, to exercise it against a real non-deterministic model when no
# Anthropic key is available. Findings are tagged provenance=shakedown, and the
# eval harness refuses to run - judge accuracy and the attacker guardrail are
# Claude-specific questions that another provider cannot answer.
# ---------------------------------------------------------------------------
# SENTINEL_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_ATTACKER_MODEL=gpt-4o
# OPENAI_TARGET_MODEL=gpt-4o-mini

SENTINEL_DB=sentinel.db
SENTINEL_HOST=127.0.0.1
SENTINEL_PORT=8000

# Everything written at runtime (SQLite, checkpoints, the Chroma store) lives
# here. Defaults to the repo root; a container points it at a mounted volume.
# SENTINEL_DATA_DIR=/data

# ---------------------------------------------------------------------------
# Access control. REQUIRED for any deployment that is not loopback-only.
#
# Unset leaves the API open, which is what the test suite and a local dev server
# want. On a public host, unset means anyone who finds the URL can POST /runs
# and spend this key up to the profile cap, per run, without limit. The scope
# record governs what a run may attack, not who may start one.
#
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# The console needs the same value as NEXT_PUBLIC_SENTINEL_TOKEN.
# ---------------------------------------------------------------------------
SENTINEL_API_TOKEN=

# Browser origins allowed to call the API, comma-separated. Defaults to the
# local console. Set this to the console's deployed origin, exactly - scheme and
# port included, no trailing slash.
# SENTINEL_CORS_ORIGINS=https://console.example.com

# ---------------------------------------------------------------------------
# Single-host deployment (docker-compose.yml + Caddyfile). Ignored locally.
# See DEPLOY.md.
#
# SITE_ADDRESS is what Caddy binds and requests a certificate for: a hostname
# for automatic TLS, or ":80" for a plain-HTTP trial with no domain.
# SITE_ORIGIN is the same host as the browser sees it, scheme included and no
# trailing slash. It becomes both the CORS allowlist and the console's API base.
# ---------------------------------------------------------------------------
# SITE_ADDRESS=sentinel.example.com
# SITE_ORIGIN=https://sentinel.example.com

# The frontend reads its own template: see frontend/.env.example
