# Build context hygiene. The two entries that matter most are .env and *.db:
# the first carries live API keys, the second is run history that has no place
# baked into an image layer.
.env
.env.*
!.env.example
*.db
*.db-shm
*.db-wal
.chroma/
cassettes/

.git/
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# The frontend has its own build context; node_modules and .next must never be
# copied in from the host, since they are platform-specific.
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo

# Reports produced by local runs. Large, and regenerated by any real audit.
live_*_report.json
tmp_*
.DS_Store
