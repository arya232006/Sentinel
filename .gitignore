# Secrets — never commit
.env
.env.local
.env.*.local
# Any backup/variant of .env carries the same keys.
.env.bak
.env.*
!.env.example

# Local databases / checkpoint stores
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
env/

# Test / tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
.cache/

# Vector / retrieval local store
.chroma/

# Frontend
node_modules/
frontend/dist/
frontend/.next/
frontend/out/
frontend/next-env.d.ts
frontend/.turbo/
frontend/tsconfig.tsbuildinfo

# HTTP cassettes may contain sensitive response bodies
cassettes/*.json
!cassettes/.gitkeep

# OS / editor
.DS_Store
Thumbs.db
.idea/
*.swp
*~
